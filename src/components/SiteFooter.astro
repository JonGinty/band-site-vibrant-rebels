---
import { isSectionVisible } from '../data/site-visibility';

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer>
  <p>
    &copy; {new Date().getFullYear()} <span class="band-name"><span class="band-name__vibrant">Vibrant</span>{' '}<span class="band-name__rebels">Rebels</span></span>
    <span class="footer-credit">Website lovingly crafted by the hard working Jonjineers over at Jonji Labs</span>
  </p>
  <div>
    <a href={`${basePath}#music`}>Music</a>
    {isSectionVisible('shows') && <a href={`${basePath}shows/`}>Shows</a>}
    {isSectionVisible('about') && <a href={`${basePath}about/`}>About</a>}
    {isSectionVisible('gallery') && <a href={`${basePath}gallery/`}>Gallery</a>}
    {isSectionVisible('press') && <a href={`${basePath}press/`}>Press kit</a>}
    <a href={`${basePath}links/`}>Links</a>
    <a href={`${basePath}#contact`}>Contact</a>
  </div>
</footer>
