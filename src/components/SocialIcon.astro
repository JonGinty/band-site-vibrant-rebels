---
import type { SimpleIcon } from 'simple-icons';

type Props = {
  icon?: SimpleIcon;
  title: string;
};

const { icon, title } = Astro.props;
---

{
  icon && (
    <svg class="social-icon" role="img" aria-label={title} viewBox="0 0 24 24" width="24" height="24">
      <path fill="currentColor" d={icon.path} />
    </svg>
  )
}
