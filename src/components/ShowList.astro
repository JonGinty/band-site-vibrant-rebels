---
import { shows, type Show } from '../data/shows';

const showBufferDays = 1;
const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});
const now = new Date();
const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const upcomingCutoff = new Date(today);
upcomingCutoff.setDate(today.getDate() - showBufferDays);

const getShowDate = (date: string) => new Date(`${date}T00:00:00`);
const sortUpcomingShows = (first: Show, second: Show) =>
  getShowDate(first.date).getTime() - getShowDate(second.date).getTime();
const sortPastShows = (first: Show, second: Show) =>
  getShowDate(second.date).getTime() - getShowDate(first.date).getTime();
// Static fallback: this split is rendered at publish/build time for no-JS visitors.
const upcomingShows = shows.filter((show) => getShowDate(show.date) >= upcomingCutoff).sort(sortUpcomingShows);
const pastShows = shows.filter((show) => getShowDate(show.date) < upcomingCutoff).sort(sortPastShows);

type ShowDisplayItem = {
  label: string;
  tooltip?: string;
};

const getShowTitle = (show: Show): ShowDisplayItem => ({
  label: show.event || show.city,
  tooltip: !show.event && show.region ? show.region : !show.venue ? show.address : undefined,
});
const getShowDetails = (show: Show): ShowDisplayItem[] => {
  const details: ShowDisplayItem[] = [];

  if (show.event) {
    details.push({ label: show.city, tooltip: show.region });
  }

  if (show.venue) {
    details.push({ label: show.venue, tooltip: show.address });
  }

  return details;
};

const hasShowTooltip = (detail: ShowDisplayItem) => Boolean(detail.tooltip);
---

<div class="show-list-root" data-shows data-show-buffer-days={showBufferDays}>
  <div class="show-group" data-show-group="upcoming">
    <div class="show-list" data-show-list="upcoming">
      {
        upcomingShows.map((show) => {
          const title = getShowTitle(show);
          const details = getShowDetails(show);

          return (
            <article class="show" data-show-card data-show-date={show.date}>
              <time datetime={show.date}>{dateFormatter.format(getShowDate(show.date))}</time>
              <div>
                <h3>
                  <span class:list={['show__detail', hasShowTooltip(title) && 'show__detail--tooltip']} tabindex={hasShowTooltip(title) ? '0' : undefined}>
                    {title.label}
                    {hasShowTooltip(title) && <span class="show__tooltip" role="tooltip">{title.tooltip}</span>}
                  </span>
                </h3>
                {details.length > 0 && (
                  <p>
                    {details.map((detail, index) => (
                      <>
                        {index > 0 && <span class="show__separator"> · </span>}
                        <span class:list={['show__detail', hasShowTooltip(detail) && 'show__detail--tooltip']} tabindex={hasShowTooltip(detail) ? '0' : undefined}>
                          {detail.label}
                          {hasShowTooltip(detail) && <span class="show__tooltip" role="tooltip">{detail.tooltip}</span>}
                        </span>
                      </>
                    ))}
                  </p>
                )}
              </div>
              {(show.website || show.ticketUrl || show.doorPrice) && (
                <div class="show__actions">
                  {show.website && <a href={show.website} target="_blank" rel="noreferrer">Info</a>}
                  {show.ticketUrl && <a href={show.ticketUrl} data-hide-past>Tickets</a>}
                  {show.doorPrice && <span data-hide-past>{show.doorPrice}</span>}
                </div>
              )}
            </article>
          );
        })
      }
    </div>
    <p class="show-empty" data-show-empty="upcoming" hidden={upcomingShows.length > 0}>
      No upcoming shows announced yet.
    </p>
  </div>

  <div class="show-group" data-show-group="past" hidden={pastShows.length === 0}>
    <h3>Past shows</h3>
    <div class="show-list" data-show-list="past">
      {
        pastShows.map((show) => {
          const title = getShowTitle(show);
          const details = getShowDetails(show);

          return (
            <article class="show show--past" data-show-card data-show-date={show.date}>
              <time datetime={show.date}>{dateFormatter.format(getShowDate(show.date))}</time>
              <div>
                <h3>
                  <span class:list={['show__detail', hasShowTooltip(title) && 'show__detail--tooltip']} tabindex={hasShowTooltip(title) ? '0' : undefined}>
                    {title.label}
                    {hasShowTooltip(title) && <span class="show__tooltip" role="tooltip">{title.tooltip}</span>}
                  </span>
                </h3>
                {details.length > 0 && (
                  <p>
                    {details.map((detail, index) => (
                      <>
                        {index > 0 && <span class="show__separator"> · </span>}
                        <span class:list={['show__detail', hasShowTooltip(detail) && 'show__detail--tooltip']} tabindex={hasShowTooltip(detail) ? '0' : undefined}>
                          {detail.label}
                          {hasShowTooltip(detail) && <span class="show__tooltip" role="tooltip">{detail.tooltip}</span>}
                        </span>
                      </>
                    ))}
                  </p>
                )}
              </div>
              {show.website && (
                <div class="show__actions">
                  <a href={show.website} target="_blank" rel="noreferrer">Info</a>
                </div>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-shows]').forEach((showsRoot) => {
    const bufferDays = Number(showsRoot.getAttribute('data-show-buffer-days') || '1');
    const upcomingList = showsRoot.querySelector<HTMLElement>('[data-show-list="upcoming"]');
    const pastList = showsRoot.querySelector<HTMLElement>('[data-show-list="past"]');
    const upcomingGroup = showsRoot.querySelector<HTMLElement>('[data-show-group="upcoming"]');
    const pastGroup = showsRoot.querySelector<HTMLElement>('[data-show-group="past"]');
    const upcomingEmpty = showsRoot.querySelector<HTMLElement>('[data-show-empty="upcoming"]');
    const today = new Date();
    const cutoff = new Date(today.getFullYear(), today.getMonth(), today.getDate());

    cutoff.setDate(cutoff.getDate() - bufferDays);

    const getCardDate = (card: Element) => new Date(`${card.getAttribute('data-show-date')}T00:00:00`).getTime();
    const cards = Array.from(showsRoot.querySelectorAll('[data-show-card]'));
    const upcomingCards = cards
      .filter((card) => getCardDate(card) >= cutoff.getTime())
      .sort((first, second) => getCardDate(first) - getCardDate(second));
    const pastCards = cards
      .filter((card) => getCardDate(card) < cutoff.getTime())
      .sort((first, second) => getCardDate(second) - getCardDate(first));

    upcomingCards.forEach((card) => upcomingList?.append(card));
    pastCards.forEach((card) => {
      card.classList.add('show--past');
      card.querySelectorAll('[data-hide-past]').forEach((element) => element.remove());
      const actions = card.querySelector('.show__actions');
      if (actions && actions.children.length === 0) {
        actions.remove();
      }
      pastList?.append(card);
    });

    if (upcomingGroup) upcomingGroup.hidden = false;
    if (pastGroup) pastGroup.hidden = pastCards.length === 0;
    if (upcomingEmpty) upcomingEmpty.hidden = upcomingCards.length > 0;
  });
</script>
