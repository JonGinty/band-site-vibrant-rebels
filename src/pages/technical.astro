---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getEntry, render } from 'astro:content';
import { isSectionVisible } from '../data/site-visibility';

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pressPath = `${basePath}press/`;
const rider = await getEntry('technical', 'vibrant-rebels-technical-rider');

if (!rider) {
  throw new Error('Technical rider content could not be found.');
}

const { Content } = await render(rider);

if (!isSectionVisible('technical')) {
  return Astro.redirect(basePath);
}
---

<BaseLayout
  title="Technical Rider | Vibrant Rebels"
  description="Technical rider for Vibrant Rebels."
>
  <SiteHeader />

  <main class="interior-page technical-page">
    <section class="technical-rider section" aria-label="Technical rider">
      <div class="technical-rider__actions print-hidden">
        <a class="button button--secondary" href={pressPath}>Back to the press kit</a>
        <button class="button button--primary" type="button" data-print-page>Print / save as PDF</button>
      </div>
      <article class="technical-rider__content">
        <Content />
      </article>
    </section>
  </main>

  <SiteFooter />

  <script>
    document.querySelectorAll('.technical-rider__content table').forEach((table) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'technical-rider__table-wrap';
      wrapper.tabIndex = 0;
      wrapper.setAttribute('role', 'region');
      wrapper.setAttribute('aria-label', 'Scrollable technical rider table');
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });

    document.querySelector('[data-print-page]')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
