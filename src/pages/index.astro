---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { socialLinks } from '../data/links';

const featuredSocialLinks = socialLinks.filter((link) => link.featured);
const getSocialSlug = (label: string) => label.toLowerCase().replace(/\s+/g, '-');
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logoPath = `${basePath}images/vibrant-rebels-logo.png`;
const linksPath = `${basePath}links/`;
const aboutPath = `${basePath}about/`;
const pressPath = `${basePath}press/`;
---

<BaseLayout>
  <SiteHeader />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__content">
        <p class="eyebrow">Your favourite new sound</p>
        <h1 id="hero-title" class="sr-only">Vibrant Rebels</h1>
        <div class="hero__logo-poster" aria-hidden="true">
          <img class="hero__logo" src={logoPath} alt="" width="2040" height="1920" />
        </div>
        <p>
          A high-energy blend of hip hop, pop, ska and funk, with dual lead singers and rappers backed by horns, keys and percussion, and a full rock band!
        </p>
        <blockquote class="quote">
          <p class="quote-text">Perfect Festival Music!</p>
          <cite class="quote-author">Mark Mghee</cite>
        </blockquote>
        <div class="hero__actions">
          <a class="button button--primary" href="#music">Listen now</a>
          <a class="button button--secondary" href="#shows">Upcoming shows</a>
        </div>
        <div class="social-strip" aria-label="Featured social links">
          {
            featuredSocialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer" data-social={getSocialSlug(link.label)} aria-label={link.handle ? `${link.label} ${link.handle}` : link.label} title={link.handle ? `${link.label} ${link.handle}` : link.label}>
                <SocialIcon icon={link.icon} title={link.label} />
                <span class="sr-only">{link.label}</span>
              </a>
            ))
          }
          <a class="social-strip__all" href={linksPath}>All links</a>
        </div>
      </div>
    </section>

    <section class="section section--split" id="music" aria-labelledby="music-title">
      <div>
        <p class="eyebrow">Latest release</p>
        <h2 id="music-title">Higher and Fresher</h2>
        <p>
          Live from ToneGarden Studios in Summerhall, Edinburgh, as part of a set of live recordings made in Spring 2026!
        </p>
      </div>
      <div class="release-video">
        <iframe
          src="https://www.youtube-nocookie.com/embed/gyAeMGh_rvI?si=HH85X2CPujSw1A-R"
          title="Higher and Fresher by Vibrant Rebels"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <section class="section shows-panel" id="shows" aria-labelledby="shows-title">
      <p class="eyebrow">Tour dates</p>
      <h2 id="shows-title">Upcoming shows</h2>
      <ShowList />
    </section>

    <section class="section section--split" id="about" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">About the band</p>
        <h2 id="about-title">Placeholder Description</h2>
      </div>
      <div class="about-summary">
        <p>
          Yo dawg, I hear you like placeholder descriptions so I wrote you a janky ass placeholder text for your band.
          I hear these folks are both vibrant and rebellious, but that can't be right? Surely not!
        </p>
        <a class="button button--secondary" href={aboutPath}>Meet the band</a>
      </div>
    </section>

    <section class="section section--contact" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">Bookings and updates</p>
      <h2 id="contact-title">Stay in the loop</h2>
      <p>For bookings, press, and mailing list updates, drop us a line.</p>
      <div class="contact-actions">
        <a class="button button--primary" href="mailto:info@vibrantrebels.com">info@vibrantrebels.com</a>
        <a class="button button--secondary" href={linksPath}>All official links</a>
        <a class="button button--secondary" href={pressPath}>Press kit</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
