---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { bandMembers } from '../data/members';
import { isSectionVisible } from '../data/site-visibility';

const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pressPath = `${basePath}press/`;
---

<BaseLayout title="About | Vibrant Rebels" description="Lorem ipsum dolor sit amet, consectetur adipiscing elit.">
  <SiteHeader />

  <main class="interior-page about-page">
    <section class="section band-bio" aria-labelledby="band-bio-title">
      <div class="band-bio__heading">
        <p class="eyebrow">Band bio</p>
        <h2 id="band-bio-title">The full story</h2>
      </div>
      <div class="band-bio__copy">
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Maecenas faucibus mollis interdum. Nullam quis risus eget urna mollis ornare vel eu leo. Aenean lacinia bibendum nulla sed consectetur.</p>
        <p>Praesent commodo cursus magna, vel scelerisque nisl consectetur et. Donec ullamcorper nulla non metus auctor fringilla. Cras mattis consectetur purus sit amet fermentum.</p>
        <p>Etiam porta sem malesuada magna mollis euismod. Vestibulum id ligula porta felis euismod semper. Sed posuere consectetur est at lobortis.</p>
        {isSectionVisible('press') && <a class="button button--secondary" href={pressPath}>Press kit</a>}
      </div>
    </section>

    <section class="section members-section" aria-labelledby="members-title">
      <p class="eyebrow">Current line-up</p>
      <h2 id="members-title">Meet the band</h2>
      <div class="member-grid" data-member-grid>
        {
          bandMembers.map((member, index) => (
            <article class="member-card" id={member.slug}>
              <figure class="member-card__portrait">
                {member.image ? (
                  <img src={`${basePath}${member.image}`} alt={member.name} loading="lazy" />
                ) : (
                  <div class="image-placeholder" role="img" aria-label={`Placeholder portrait for ${member.name}`}>
                    <span>Photo placeholder {String(index + 1).padStart(2, '0')}</span>
                  </div>
                )}
              </figure>
              <div class="member-card__copy">
                <p class="member-card__role">{member.role}</p>
                <h3>{member.name}</h3>
                <div class="member-card__bio-wrap">
                  <p class="member-card__bio-preview">{member.bio}</p>
                  <details class="member-card__details">
                    <summary>Read full bio</summary>
                    <p class="member-card__bio">{member.bio}</p>
                  </details>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const memberGrid = document.querySelector<HTMLElement>('[data-member-grid]');

  if (memberGrid) {
    const prioritySlugs = new Set(['oz', 'sarah', 'boyd-mckay']);
    const memberCards = Array.from(memberGrid.children);
    const priorityCards = memberCards.filter((card) => prioritySlugs.has(card.id));
    const otherCards = memberCards.filter((card) => !prioritySlugs.has(card.id));

    const shuffle = (cards: Element[]) => {
      for (let index = cards.length - 1; index > 0; index -= 1) {
        const randomIndex = Math.floor(Math.random() * (index + 1));
        const currentCard = cards[index];

        cards[index] = cards[randomIndex];
        cards[randomIndex] = currentCard;
      }

      return cards;
    };

    [...shuffle(priorityCards), ...shuffle(otherCards)].forEach((card) => memberGrid.append(card));
  }
</script>
